# Signing material — never commit these. Losing them costs days; leaking them
# lets someone else sign an update as you. They live in the Drive backup instead.
*.jks
*.keystore
keystore.properties

# Build output
build/
app/build/
.gradle/
.cxx/
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
.kotlin/
captures/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Play publishing key, if it is ever copied into the project by mistake
service-account.json
*-service-account.json

# Python leaves these behind when the server's tests are run
__pycache__/
*.pyc
