<?xml version="1.0" encoding="utf-8"?>
<!--
   What Android's own backup (to the owner's Google account) may copy, on Android 11 and older.
   Everything, except the sign-in to a Zenith account: that is a key, and a key is not copied to
   another phone behind anyone's back. On a new phone you sign in again.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="account.xml" />
</full-backup-content>
