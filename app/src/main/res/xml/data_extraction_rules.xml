<?xml version="1.0" encoding="utf-8"?>
<!--
   The same rule as backup_rules.xml, for Android 12 and newer: the sign-in to a Zenith account is
   left out of Android's cloud backup and out of a phone-to-phone transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
