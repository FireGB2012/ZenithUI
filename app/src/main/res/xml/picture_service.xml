<?xml version="1.0" encoding="utf-8"?>
<!-- Zenith's app picture helper: told only that another screen came to the front, which apps say
     whoever is listening, and allowed to take a screenshot. It cannot read what is on the screen.
     The pictures stay in memory only, five minutes at most; nothing is written down or sent. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/picture_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:summary="@string/picture_service_summary" />
